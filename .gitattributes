# =====================================================================
# LOW TIDE - .gitattributes
# Line endings: normalize to LF in repo; CRLF only for Windows scripts.
# Binaries: Git LFS. Not lockable (solo dev; avoids read-only files).
# =====================================================================

# ---------- Default ----------
* text=auto eol=lf

# ---------- Source / text (explicit) ----------
*.h        text eol=lf diff=cpp
*.hpp      text eol=lf diff=cpp
*.inl      text eol=lf diff=cpp
*.c        text eol=lf diff=cpp
*.cpp      text eol=lf diff=cpp
*.cmake    text eol=lf
CMakeLists.txt text eol=lf
*.py       text eol=lf diff=python
*.json     text eol=lf
*.setreg   text eol=lf
*.setregpatch text eol=lf
*.prefab   text eol=lf
*.material text eol=lf
*.materialtype text eol=lf
*.assetinfo text eol=lf
*.azasset  text eol=lf
*.physxmaterial text eol=lf
*.animgraph text eol=lf
*.motionset text eol=lf
*.azsl     text eol=lf
*.azsli    text eol=lf
*.shader   text eol=lf
*.uicanvas text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.csv      text eol=lf
*.wproj    text eol=lf
*.wwu      text eol=lf
*.sh       text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---------- 3D / DCC (LFS) ----------
