{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-vs2022",
      "displayName": "Windows / VS2022 / multi-config (debug, profile, release)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "LY_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "win-vs2022-mono",
      "displayName": "Windows / VS2022 / monolithic game launcher (release only; disables tools and tests)",
      "inherits": "win-vs2022",
      "binaryDir": "${sourceDir}/build/windows_mono",
      "cacheVariables": {
        "LY_MONOLITHIC_GAME": "ON"
      }
    },
    {
      "name": "win-vs2022-asan",
      "displayName": "Windows / VS2022 / AddressSanitizer",
      "inherits": "win-vs2022",
      "binaryDir": "${sourceDir}/build/windows_asan",
      "cacheVariables": {
        "LY_UNITY_BUILD": "OFF",
        "LY_BUILD_WITH_ADDRESS_SANITIZER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "win-vs2022", "configuration": "debug",   "targets": ["Editor", "LowTide.GameLauncher"] },
    { "name": "profile", "configurePreset": "win-vs2022", "configuration": "profile", "targets": ["Editor", "LowTide.GameLauncher", "AssetProcessor", "AssetProcessorBatch"] },
    { "name": "release", "configurePreset": "win-vs2022-mono", "configuration": "release", "targets": ["LowTide.GameLauncher"] },
    { "name": "asan",    "configurePreset": "win-vs2022-asan", "configuration": "debug", "targets": ["LowTide.GameLauncher", "LowTideStreaming.Tests"] }
  ],
  "testPresets": [
    {
      "name": "profile-tests",
      "configurePreset": "win-vs2022",
      "configuration": "profile",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "LowTide", "label": "SUITE_main" } }
    }
  ]
}
